modules = ["python-3.11", "nodejs-20", "postgresql-16"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "gunicorn --bind=0.0.0.0:5000 --reuse-port --workers=1 --threads=24 --worker-class=gthread app:app"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind=0.0.0.0:5000", "--reuse-port", "--workers=1", "--threads=24", "--worker-class=gthread", "app:app"]

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
METERED_API_KEY = "e1b1e041f9f6576d127d91ad77a5b9f09dea"
METERED_APP_NAME = "wavelycalling.metered.live"
