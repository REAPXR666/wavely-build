{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wavely Protection",
  "version": "0.1.0",
  "identifier": "com.wavely.protection",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wavely Protection",
        "width": 1280,
        "height": 832,
        "minWidth": 1040,
        "minHeight": 720,
        "decorations": false,
        "transparent": false,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0a0e1a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
